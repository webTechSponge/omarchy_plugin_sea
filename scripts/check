#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
scripts/build-preview
lib/preview-decode --check
omarchy plugin validate .
for file in bin/* scripts/* tests/*.sh; do
  [[ -f $file ]] || continue
  bash -n "$file"
done
scripts/qml-check
for test in tests/*.sh; do [[ ! -f $test ]] || bash "$test"; done
scripts/test-integration
git diff --check
printf 'All project checks passed.\n'
