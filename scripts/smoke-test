#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
command -v jq >/dev/null
timeout 5 omarchy-shell shell ping >/dev/null
scripts/open-verified-runtime
status() { omarchy-shell shell call webtechsponge.plugin-sea status '{}'; }
status | jq -e '.opened==true' >/dev/null
for ((i=0;i<120;i++)); do
  result=$(status)
  if jq -e '.count>0 and .localError==""' <<<"$result" >/dev/null; then break; fi
  sleep 0.25
done
jq -e '.count>0 and .localError==""' <<<"$result" >/dev/null
omarchy-shell shell hide webtechsponge.plugin-sea
status | jq -e '.opened==false' >/dev/null
# A locally authored inert panel proves actual lifecycle transitions without
# downloading or executing any third-party community implementation.
id=local.oma-plug-sea-smoke
fixture="$HOME/.config/omarchy/plugins/$id"
[[ ! -e $fixture && ! -L $fixture ]] || { echo "Refusing existing fixture: $fixture" >&2; exit 1; }
mkdir -p "$fixture"
touch "$fixture/.oma-plug-sea-smoke-owned"
cleanup() {
  if [[ -f $fixture/.oma-plug-sea-smoke-owned ]]; then
    omarchy plugin disable "$id" >/dev/null 2>&1 || true
    omarchy plugin remove "$id" --yes >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT
cat > "$fixture/manifest.json" <<'JSON'
{"schemaVersion":1,"id":"local.oma-plug-sea-smoke","name":"Omarchy Plugin Sea inert smoke fixture","version":"0.0.0","kinds":["panel"],"entryPoints":{"panel":"Fixture.qml"}}
JSON
printf 'import QtQuick\nItem { function open(payload) {} function close() {} }\n' > "$fixture/Fixture.qml"
omarchy plugin validate "$fixture"
omarchy-shell shell rescanPlugins
for ((i=0;i<40;i++)); do
  if omarchy plugin list --json | jq -e --arg id "$id" 'any(.[];.id==$id)' >/dev/null; then break; fi
  sleep 0.25
done
# Local-only community code is deliberately outside the reviewed-snapshot path.
bin/oma-plug-sea-action enable "$id" --consent-unsandboxed | jq -e '.ok==false and all(.plugins[];select(.id=="local.oma-plug-sea-smoke")|(.enabled|not))' >/dev/null
# Explicit external management is safe here: this fixture was authored above,
# contains only an inert Item, and is never arbitrary third-party code.
omarchy plugin enable "$id"
omarchy plugin list --json | jq -e --arg id "$id" 'any(.[];.id==$id and .enabled)' >/dev/null
bin/oma-plug-sea-action disable "$id" | jq -e '.ok==true and any(.plugins[];.id=="local.oma-plug-sea-smoke" and (.enabled|not))' >/dev/null
bin/oma-plug-sea-action remove "$id" --confirm-remove | jq -e '.ok==true and all(.plugins[];.id!="local.oma-plug-sea-smoke")' >/dev/null
[[ ! -e $fixture ]]
trap - EXIT
scripts/open-verified-runtime
status | jq -e '.opened==true' >/dev/null
omarchy-shell shell hide webtechsponge.plugin-sea
printf 'Real shell load/summon/hide, local-only enable refusal, and externally enabled inert fixture disable/remove passed.\n'
